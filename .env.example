# Copy to .env and edit. `docker compose` reads this file automatically.

# --- Postgres (only used by the bundled `db` service) -------------------------
POSTGRES_USER=impulsebuy
POSTGRES_PASSWORD=impulsebuy
POSTGRES_DB=impulsebuy

# --- Database the API talks to ------------------------------------------------
# Default: the bundled Postgres. Paste a Supabase connection string to use the
# cloud database instead (session pooler for containers, transaction pooler for
# serverless) — see DEPLOYMENT.md.
DATABASE_URL=postgresql+psycopg://impulsebuy:impulsebuy@db:5432/impulsebuy

# --- Secrets ------------------------------------------------------------------
ADMIN_TOKEN=dev-admin-token
IMAGE_URL_SECRET=dev-image-secret

# --- URLs ---------------------------------------------------------------------
# Origin the browser uses to reach the API. With this compose that is the web
# container (nginx proxies /v1 and /media).
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Image storage ------------------------------------------------------------
# s3 (default here) uses the bundled MinIO; set `local` to write files to the
# api container's media volume instead.
MEDIA_BACKEND=s3
S3_BUCKET=impulsebuy-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=impulsebuy
S3_SECRET_ACCESS_KEY=impulsebuy-secret
S3_KEY_PREFIX=

# --- Web build (Vite inlines these into the bundle) ---------------------------
VITE_API_BASE_URL=/v1
VITE_WS_URL=ws://localhost:8080/v1

# --- Development data ---------------------------------------------------------
SEED_FIXTURES=1
TIME_SCALE=1.0
