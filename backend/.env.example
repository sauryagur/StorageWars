IMAGE_URL_TTL_SECONDS=300
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTHOR_SECONDS=60
CARD_CAP_SECONDS=20
MIN_DWELL_SECONDS=3
