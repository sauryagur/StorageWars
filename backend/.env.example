# --- Database -----------------------------------------------------------------
# Local docker compose default. In production this is your Supabase string:
#   Session pooler (containers):     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler (serverless): postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# `postgres://` and `postgresql://` are accepted; the driver name and sslmode
# are filled in for you.
DATABASE_URL=postgresql+psycopg://impulsebuy:impulsebuy@localhost:5432/impulsebuy

# --- Secrets ------------------------------------------------------------------
ADMIN_TOKEN=replace-with-a-long-random-token
IMAGE_URL_SECRET=replace-with-a-long-random-secret
SESSION_TOKEN_BYTES=32

# --- URLs ---------------------------------------------------------------------
# Origin the browser uses for this API. Signed image URLs are built from it.
PUBLIC_BASE_URL=http://localhost:3000
IMAGE_URL_TTL_SECONDS=300
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Image storage ------------------------------------------------------------
# local: files under MEDIA_ROOT. s3: S3-compatible bucket (AWS S3, MinIO,
# Cloudflare R2, Supabase Storage). Required on Vercel: function filesystems
# are read-only and ephemeral.
MEDIA_BACKEND=local
MEDIA_ROOT=media
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS S3. Set for MinIO/R2/Supabase Storage.
S3_ENDPOINT_URL=
# Only when the browser must reach the bucket at a different address than the
# API does (docker compose: internal `http://minio:9000` vs published
# `http://localhost:9000`).
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SECONDS=120

# --- Runtime shape ------------------------------------------------------------
# Set automatically on Vercel (VERCEL=1). Vercel also defaults DB_POOL_SIZE=1
# and DB_PREPARE_STATEMENTS=0 for Supabase's transaction pooler.
VERCEL=
DB_POOL_SIZE=5
DB_PREPARE_STATEMENTS=1

# --- Game timing --------------------------------------------------------------
AUTHOR_SECONDS=60
CARD_CAP_SECONDS=20
MIN_DWELL_SECONDS=3
DRIP_BULLETS_SECONDS=5
DRIP_RATING_SECONDS=10
SLIDE_SECONDS=12
VOTE_SECONDS=30
VOTEKICK_SECONDS=30
REJOIN_GRACE_SECONDS=120
SEAT_CLAIM_SECONDS=60
ROOM_TTL_SECONDS=1800
HEARTBEAT_SECONDS=15
PROGRESS_COALESCE_MS=500
# Game-time multiplier: 1.0 is real time, 0.1 makes every phase 10x longer.
TIME_SCALE=1.0

# --- Development data ---------------------------------------------------------
# 1 seeds 12 categories and 24 deterministic products on startup.
SEED_FIXTURES=0
